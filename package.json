{
  "name": "worstcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "npm run generate:web-demo && vite build --config apps/web/vite.config.ts",
    "generate:web-demo": "vite-node apps/web/scripts/generate-demo-artifacts.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:contracts": "vitest run tests/phase0/contracts.test.ts",
    "verify:model-semantics": "vitest run tests/phase0/model-semantics.test.ts",
    "verify:threat-model": "vitest run tests/phase0/threat-model.test.ts",
    "verify:fixtures": "vitest run tests/phase0/fixtures.test.ts",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "test:phase1": "vitest run tests/phase1/oracle.test.ts",
    "test:determinism": "vitest run tests/phase1/determinism.test.ts",
    "test:counterexample": "vitest run tests/phase1/counterexample.test.ts",
    "test:unknown": "vitest run tests/phase1/unknown.test.ts",
    "test:sandbox": "vitest run tests/phase1/sandbox.test.ts",
    "test:registry": "forge test --offline -vv",
    "test:replay": "vitest run tests/phase2/replay.test.ts",
    "test:zerog:failures": "vitest run tests/phase2/zerog-failures.test.ts",
    "verify:adapter:container": "bash scripts/verify-adapter-container.sh",
    "verify:zerog:compute:live": "node scripts/require-live-evidence.mjs compute",
    "verify:zerog:storage:live": "node scripts/require-live-evidence.mjs storage",
    "verify:zerog:chain:live": "node scripts/require-live-evidence.mjs chain",
    "serve:api": "vite-node scripts/serve-api.ts",
    "check:agent": "vite-node scripts/check-agent.ts",
    "build:api": "node scripts/build-api.mjs",
    "build:vercel": "npm run build:api && WORSTCASE_BASE=/ npm run build:web",
    "preinstall": "node scripts/check-node.mjs",
    "pretest": "node scripts/check-node.mjs"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "1.2.11",
    "ethers": "^6.17.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "7.3.6",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "ethers": "^6.17.0",
    "axios": "^1.12.0"
  },
  "description": "Pre-funding model checker for AI agents with payment-capable tools: the maximum reachable loss and the shortest call sequence that reaches it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yonkoo11/worstcase.git"
  }
}
